    <label>Solicitação</label>
    <pluralLabel>Solicitações</pluralLabel>
    <description>Gerencia as solicitações cadastradas no sistema, incluindo solicitante, responsável, prioridade e status.</description>
    <nameField>
        <label>Nome da Solicitação</label>
        <type>Text</type>
    </nameField>
    <enableBulkApi>true</enableBulkApi>
    <enableSharing>true</enableSharing>
